server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name keep-it-all.com www.keep-it-all.com;

    ssl_certificate /etc/letsencrypt/live/keep-it-all.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/keep-it-all.com/privkey.pem;

    # ===== FRONTEND =====
    root /tmp/cave/dist;
    index index.html;

    # Serve static assets directly (don't redirect to index.html)
    location /assets/ {
        # Static assets must be found on disk
        try_files $uri =404;
    }

    location / {
        # Try to serve as static file from root /tmp/cave/dist
        # If not found, proxy to Node.js backend (for WebSocket or SPA)
        try_files $uri @backend;
    }

    location @backend {
        # WebSocket or other requests to Node.js backend
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        
        # WebSocket support - CRITICAL for real-time updates
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        
        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts for long-lived connections (WebSocket)
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # ===== API =====
    location /api/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name keep-it-all.com www.keep-it-all.com;
    return 301 https://$host$request_uri;
}

